#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"

export MISE_VERSION="v2026.7.12"
export MISE_TRUSTED_CONFIG_PATHS="${repo_root}"

mise_bin="${HOME}/.local/bin/mise"
installed_mise_version="$("${mise_bin}" --version 2>/dev/null | awk '{ print $1 }' || true)"
if [ "${installed_mise_version}" != "${MISE_VERSION#v}" ]; then
  echo "[setup] Installing mise ${MISE_VERSION}"
  curl -fsSL https://mise.run | MISE_VERSION="${MISE_VERSION}" sh
fi

echo "[setup] Installing pinned development tools"
"${mise_bin}" trust --yes mise.toml
"${mise_bin}" install --locked

# Amp's non-interactive shell does not source mise activation scripts.
mkdir -p "${HOME}/.local/bin"
shim_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/mise}/shims"
for command in go gofmt golangci-lint just; do
  if [ -e "${shim_dir}/${command}" ]; then
    ln -sfn "${shim_dir}/${command}" "${HOME}/.local/bin/${command}"
  fi
done

echo "[setup] Downloading Go modules"
"${mise_bin}" exec -- go mod download

"${mise_bin}" exec -- go version
"${mise_bin}" exec -- golangci-lint version
echo "[setup] Complete"
