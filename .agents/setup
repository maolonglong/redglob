#!/usr/bin/env bash
set -euo pipefail

readonly GO_VERSION="1.26.5"
readonly GO_SHA256="5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053"
readonly GO_ROOT="$HOME/.local/share/go/$GO_VERSION"
readonly BIN_DIR="$HOME/.local/bin"

step_started=$SECONDS
echo "[setup] Ensuring Go $GO_VERSION is installed"
if [[ ! -x "$GO_ROOT/bin/go" ]]; then
  archive="$(mktemp)"
  extract_dir="$(mktemp -d)"
  trap 'rm -f "$archive"; rm -rf "$extract_dir"' EXIT

  curl --fail --location --retry 3 \
    "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
    --output "$archive"
  echo "$GO_SHA256  $archive" | sha256sum --check --status

  mkdir -p "$(dirname "$GO_ROOT")"
  tar -C "$extract_dir" -xzf "$archive"
  rm -rf "$GO_ROOT"
  mv "$extract_dir/go" "$GO_ROOT"
fi
mkdir -p "$BIN_DIR"
ln -sfn "$GO_ROOT/bin/go" "$BIN_DIR/go"
ln -sfn "$GO_ROOT/bin/gofmt" "$BIN_DIR/gofmt"
echo "[setup] Go ready in $((SECONDS - step_started))s"

step_started=$SECONDS
echo "[setup] Downloading Go modules"
"$GO_ROOT/bin/go" mod download
echo "[setup] Go modules ready in $((SECONDS - step_started))s"

"$GO_ROOT/bin/go" version
echo "[setup] Complete"
